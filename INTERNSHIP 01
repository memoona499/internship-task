
import random

# List of words
words = [
    "python",
    "computer",
    "programming",
    "science",
    "keyboard",
    "database",
    "biology",
    "internet",
    "software",
    "developer"
]

# Hangman stages
hangman_art = [
    """
     -----
     |   |
         |
         |
         |
    ========
    """,
    """
     -----
     |   |
     O   |
         |
         |
    ========
    """,
    """
     -----
     |   |
     O   |
     |   |
         |
    ========
    """,
    """
     -----
     |   |
     O   |
    /|   |
         |
    ========
    """,
    """
     -----
     |   |
     O   |
    /|\\  |
         |
    ========
    """,
    """
     -----
     |   |
     O   |
    /|\\  |
    /    |
    ========
    """,
    """
     -----
     |   |
     O   |
    /|\\  |
    / \\  |
    ========
    """
]

# Select a random word
secret_word = random.choice(words)

# Store guessed letters
guessed_letters = set()

# Total attempts
attempts = 6

print("================================")
print("       WELCOME TO HANGMAN")
print("================================")

# Game loop
while attempts > 0:

    print(hangman_art[6 - attempts])

    # Display the hidden word
    display_word = ""

    for letter in secret_word:
        if letter in guessed_letters:
            display_word += letter.upper() + " "
        else:
            display_word += "_ "

    print("\nWord:", display_word)
    print("Remaining attempts:", attempts)

    if all(letter in guessed_letters for letter in secret_word):
        print("\nCongratulations! You guessed the word!")
        print("The word was:", secret_word.upper())
        break

    print("Guessed letters:", sorted(guessed_letters))

    guess = input("\nGuess a letter: ").lower().strip()

    # Validate input
    if len(guess) != 1 or not guess.isalpha():
        print("Please enter only one alphabet letter.")
        continue

    # Check duplicate guesses
    if guess in guessed_letters:
        print("You already guessed this letter!")
        continue

    guessed_letters.add(guess)

    # Check the guess
    if guess in secret_word:
        print("Correct guess!")
    else:
        attempts -= 1
        print("Wrong guess!")

# Losing condition
if attempts == 0:
    print(hangman_art[6])
    print("\nGAME OVER!")
    print("The correct word was:", secret_word.upper())

print("\nThanks for playing Hangman!")
